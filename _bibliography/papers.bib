  abbr      = {SAT 2026},
  title     = {{NLIPSat}: Satisfiability-Based Nonlinear Integer Programming Encoding Toolkit},
  author    = {Yangli, Zhengling and Zheng, Zhifei and Cherif, Sami and Shibasaki, Rui Sá and Li, Chu-Min},
  booktitle = {29th International Conference on Theory and Applications of Satisfiability Testing (SAT 2026)},
  series    = {Leibniz International Proceedings in Informatics (LIPIcs)},
  volume    = {377},
  pages     = {43:1--43:13},
  year      = {2026},
  publisher = {Schloss Dagstuhl -- Leibniz-Zentrum für Informatik},
  selected  = {true},
  doi       = {10.4230/LIPIcs.SAT.2026.43},
  html      = {https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.SAT.2026.43},
