---
layout: default
---
{% assign is_zh = false %}
{% if page.lang == 'zh' %}{% assign is_zh = true %}{% endif %}
<div class="public-profile">
  <header class="profile-hero">
    <div class="hero-copy">
      <p class="profile-eyebrow">
        {% if is_zh %}云南大学 · 统计学 · 2024 级{% else %}Yunnan University · Statistics · Class of 2024{% endif %}
      </p>
      <h1>
        {% if is_zh -%}
          杨李正凌<span class="name-secondary">Zhengling Yangli</span>
        {%- else -%}
          Zhengling Yangli<span class="name-secondary">杨李正凌</span>
        {%- endif %}
      </h1>
      <p class="hero-statement">{{ page.headline }}</p>
      <p class="hero-intro">{{ page.intro }}</p>
      <div class="profile-actions">
        <a class="profile-button primary" href="#research">
          {%- if is_zh %}认识我的研究{% else %}Explore my research{% endif %}
          <span aria-hidden="true">↘</span></a
        >
        <a class="profile-button" href="{{ '/cv/' | relative_url }}">
          {%- if is_zh %}个人简历{% else %}View CV{% endif %}
          <span aria-hidden="true">↗</span></a
        >
        <a class="profile-text-link" href="#contact">
          {%- if is_zh %}联系我{% else %}Get in touch{% endif -%}
        </a>
      </div>
    </div>
    <figure class="hero-portrait">
      {% assign portrait = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading='eager' path=portrait class='portrait-image' sizes='(max-width: 767px) 128px, 210px' alt='Zhengling Yangli / 杨李正凌' cache_bust=true %}
      <figcaption>
        {% if is_zh -%}
          数学与统计学院<br>
          云南大学 · 昆明
        {%- else -%}
          School of Mathematics and Statistics<br>
          Kunming, China
        {%- endif %}
      </figcaption>
    </figure>
  </header>
  <nav class="profile-sections" aria-label="{% if is_zh %}本页目录{% else %}On this page{% endif %}">
    <a href="#research">
      {%- if is_zh %}代表研究{% else %}Research{% endif -%}
    </a>
    <a href="#journey">
      {%- if is_zh %}我的路径{% else %}My path{% endif -%}
    </a>
    <a href="#experience">
      {%- if is_zh %}精选经历{% else %}Experience{% endif -%}
    </a>
    <a href="#contact">
      {%- if is_zh %}联系{% else %}Contact{% endif -%}
    </a>
  </nav>
  <article class="profile-content">{{ content }}</article>
</div>
